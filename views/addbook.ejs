<!doctype html>
<html>

<head>
    <title>Add Book to <%= shopData.shopName %>
    </title>
    <link rel="stylesheet" type="text/css" href="/main.css" />
</head>

<body>
    <h1>Add Book to <%= shopData.shopName %>
    </h1>

    <!-- Show server-side validation errors, if any -->
    <% if (typeof errors !=='undefined' && errors.length> 0) { %>
        <div class="error-box">
            <ul>
                <% errors.forEach(function(error) { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
        </div>
        <% } %>

            <form method="POST" action="/books/bookadded">
                <p>Book name:
                    <input id="name" type="text" name="name" value="<%= typeof name !== 'undefined' ? name : '' %>"
                        required />
                </p>

                <p>Price:
                    <input id="price" type="text" name="price" value="<%= typeof price !== 'undefined' ? price : '' %>"
                        required />
                </p>

                <input type="submit" value="Add Book" />
            </form>

            <p><a href="/books/list">Back to book list</a></p>
            <p><a href="/">Home</a></p>
</body>

</html>