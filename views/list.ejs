<!DOCTYPE html>
<html>

<head>
    <title>
        <%= shopData.shopName %> - Book List
    </title>
    <link rel="stylesheet" href="/main.css">
</head>

<body>
    <header>
        <h1>
            <%= shopData.shopName %> - Book List
        </h1>

        <nav>
            <a href="/">Home</a>
            <a href="/about">About <%= shopData.shopName %></a>
            <a href="/books/search">Search for books</a>
            <a href="/books/bargainbooks">Bargain Books</a>
            <a href="/books/list">List books</a>
            <a href="/books/addbook">Add a new book</a>

            <% if (username) { %>
                <span class="welcome">Welcome, <%= username %>!</span>
                <a href="/users/list">Users</a>
                <a href="/users/audit">Audit log</a>
                <a href="/users/logout">Logout</a>
                <% } else { %>
                    <a href="/users/login">Login</a>
                    <a href="/users/register">Register</a>
                    <% } %>
        </nav>
        <hr>
    </header>

    <main>
        <h2>Available Books</h2>

        <table border="1" cellpadding="10">
            <tr>
                <th>Book Name</th>
                <th>Price (£)</th>
            </tr>

            <% availableBooks.forEach(function(book) { %>
                <tr>
                    <td>
                        <%= book.name %>
                    </td>
                    <td>
                        <%= book.price %>
                    </td>
                </tr>
                <% }); %>
        </table>
    </main>
</body>

</html>