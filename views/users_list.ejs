<!doctype html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Users - <%= shopData.shopName %>
    </title>
    <link rel="stylesheet" type="text/css" href="/main.css" />
</head>

<body>
    <h1>Registered Users</h1>

    <table border="1" cellpadding="5">
        <tr>
            <th>Username</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
        </tr>
        <% users.forEach(user=> { %>
            <tr>
                <td>
                    <%= user.username %>
                </td>
                <td>
                    <%= user.first_name %>
                </td>
                <td>
                    <%= user.last_name %>
                </td>
                <td>
                    <%= user.email %>
                </td>
            </tr>
            <% }); %>
    </table>

    <p><a href="/">Home</a></p>
</body>

</html>