<!doctype html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Register for <%= shopData.shopName %>
  </title>
  <link rel="stylesheet" type="text/css" href="/main.css" />
</head>

<body>

  <h1>Register for <%= shopData.shopName %>
  </h1>

  <% if (typeof errors !=='undefined' && errors.length> 0) { %>
    <div class="error-box">
      <ul>
        <% errors.forEach(function(error) { %>
          <li>
            <%= error.msg %>
          </li>
          <% }) %>
      </ul>
    </div>
    <% } %>

      <form method="POST" action="/users/registered">

        <p>Username:
          <input id="username" type="text" name="username"
            value="<%= typeof username !== 'undefined' ? username : '' %>" required />
        </p>

        <p>First name:
          <input id="first" type="text" name="first" value="<%= typeof first !== 'undefined' ? first : '' %>"
            required />
        </p>

        <p>Last name:
          <input id="last" type="text" name="last" value="<%= typeof last !== 'undefined' ? last : '' %>" required />
        </p>

        <p>Email:
          <input id="email" type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>"
            required />
        </p>

        <p>Password:
          <input id="password" type="password" name="password" required />
        </p>

        <input type="submit" value="Register" />
      </form>

      <p><a href="/">Home</a></p>

</body>

</html>